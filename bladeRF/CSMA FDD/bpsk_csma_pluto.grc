options:
  parameters:
    alias: ''
    author: Rivija Pesara (framing from Barry Duggan BPSK example)
    catch_exceptions: 'False'
    comment: ''
    copyright: ''
    description: 'Four-node shared-channel BPSK link: CSMA/CA medium access, per-peer ARQ, browser chat
      (r6b)'
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: bpsk_csma_pluto
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: BPSK CSMA Chat Node (shared channel, TDD)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8.0
    rotation: 0
    state: enabled
blocks:
- name: ack_timeout
  id: variable
  parameters:
    comment: seconds before retransmit
    value: '0.5'
