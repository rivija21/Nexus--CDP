- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ add_header(gr.basic_block):\n    def __init__(self, dest_id=2, src_id=1):\n\
      \        gr.basic_block.__init__(self, name=\"Add Header\", in_sig=None, out_sig=None)\n\
      \        self.dest_id = dest_id\n        self.src_id = src_id\n        self.message_port_register_in(pmt.mp(\"\
      in\"))\n        self.message_port_register_out(pmt.mp(\"out\"))\n        self.set_msg_handler(pmt.mp(\"\
      in\"), self.handle_msg)\n\n    def handle_msg(self, msg):\n        meta = pmt.car(msg)\n\
      \        payload = list(pmt.u8vector_elements(pmt.cdr(msg)))\n        \n   \
      \     # 3-Byte Header: [DEST_ID, SRC_ID, PAYLOAD_LEN]\n        header = [self.dest_id,\
      \ self.src_id, len(payload)]\n        packet = header + payload\n        \n\
      \        pdu_out = pmt.init_u8vector(len(packet), packet)\n        self.message_port_pub(pmt.mp(\"\
      out\"), pmt.cons(meta, pdu_out))\n"
    affinity: ''
    alias: ''
    comment: ''
    dest_id: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
    src_id: '1'
  states:
    _io_cache: ('Add Header', 'add_header', [('dest_id', '2'), ('src_id', '1')], [('in',
      'message', 1)], [('out', 'message', 1)], '', ['dest_id', 'src_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 64.0]
    rotation: 0
    state: enabled
- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ add_preamble_pad(gr.basic_block):\n    def __init__(self):\n        gr.basic_block.__init__(self,\
      \ name=\"Add Preamble & Pad\", in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.mp(\"\
      in\"))\n        self.message_port_register_out(pmt.mp(\"out\"))\n        self.set_msg_handler(pmt.mp(\"\
      in\"), self.handle_msg)\n\n    def handle_msg(self, msg):\n        meta = pmt.car(msg)\n\
      \        vec = list(pmt.u8vector_elements(pmt.cdr(msg)))\n        \n       \
      \ # Pad short messages to at least 16 bytes\n        min_bytes = 16\n      \
      \  if len(vec) < min_bytes:\n            vec += [0x00] * (min_bytes - len(vec))\n\
      \            \n        # FIX: Increased dummy preamble from 48 to 128 bytes\
      \ for cold-start AGC lock\n        dummy = [0x55] * 128\n        preamble =\
      \ [0xAC, 0x62, 0x0D, 0xCD]\n        \n        full_packet = dummy + preamble\
      \ + vec\n        pdu_out = pmt.init_u8vector(len(full_packet), full_packet)\n\
      \        self.message_port_pub(pmt.mp(\"out\"), pmt.cons(meta, pdu_out))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Add Preamble & Pad', 'add_preamble_pad', [], [('in', 'message', 1)],
      [('out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 80.0]
    rotation: 0
    state: enabled
