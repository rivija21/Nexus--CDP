options:
  parameters:
    alias: ''
    author: Rivija Pesara (framing from Barry Duggan BPSK example)
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: Full-duplex FDD BPSK link with addressing and stop-and-wait ARQ
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: bpsk_duplex_pluto
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: BPSK Duplex Link (Pluto, FDD)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8.0]
    rotation: 0
    state: enabled

blocks:
- name: ack_timeout
  id: variable
  parameters:
    comment: seconds before retransmit
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 376.0]
    rotation: 0
    state: true
- name: constel
  id: variable_constellation
  parameters:
