- name: epy_block_addr_filter_ack
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ sys\n\nHDR_LEN = 7\nTYPE_ACK = 3\nBROADCAST = 255\n\n\nclass addr_filter_ack(gr.basic_block):\n\
      \    \"\"\"Runs on CRC-verified frames only (digital_crc32_async_bb in check\n\
      \    mode already dropped anything corrupted upstream of this block).\n    Enforces\
      \ unique addressing, forwards accepted frames to the app, and\n    auto-generates\
      \ + transmits an ACK for anything that isn't itself an\n    ACK.\"\"\"\n\n \
      \   def __init__(self, my_id=1):\n        gr.basic_block.__init__(self, name=\"\
      Address Filter + Auto-ACK\", in_sig=None, out_sig=None)\n        self.my_id\
      \ = my_id\n        self.message_port_register_in(pmt.mp(\"in\"))\n        self.message_port_register_out(pmt.mp(\"\
      payload_out\"))\n        self.message_port_register_out(pmt.mp(\"ack_out\"))\n\
      \        self.set_msg_handler(pmt.mp(\"in\"), self.handle_msg)\n\n    def handle_msg(self,\
      \ msg):\n        meta = pmt.car(msg)\n        frame = list(pmt.u8vector_elements(pmt.cdr(msg)))\n\
      \n        if len(frame) < HDR_LEN:\n            return\n\n        dest_id, src_id,\
      \ msg_id, frag_idx, frag_tot, msg_type, length = frame[:HDR_LEN]\n\n       \
      \ if dest_id != self.my_id and dest_id != BROADCAST:\n            return  #\
      \ not addressed to us -- unique-addressing requirement\n\n        # Hand the\
      \ whole validated frame (header+payload) up to the app.\n        # Covers both\
      \ data fragments and ACK frames; the app tells them\n        # apart by the\
      \ `type` byte in the header.\n        pdu_out = pmt.init_u8vector(len(frame),\
      \ frame)\n        self.message_port_pub(pmt.mp(\"payload_out\"), pmt.cons(meta,\
      \ pdu_out))\n\n        sys.__stdout__.write(\n            f\"[RX] type={msg_type}\
      \ src={src_id} msg_id={msg_id} \"\n            f\"frag={frag_idx}/{frag_tot}\
      \ len={length}\\n\"\n        )\n        sys.__stdout__.flush()\n\n        if\
      \ msg_type != TYPE_ACK:\n            ack = [src_id, self.my_id, msg_id, frag_idx,\
      \ 1, TYPE_ACK, 0]\n            ack_pdu = pmt.init_u8vector(len(ack), ack)\n\
      \            self.message_port_pub(pmt.mp(\"ack_out\"), pmt.cons(meta, ack_pdu))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_id: my_id
  states:
    _io_cache: ('Address Filter + Auto-ACK', 'addr_filter_ack', [('my_id', '1')],
      [('in', 'message', 1)], [('ack_out', 'message', 1), ('payload_out', 'message',
      1)], "Runs on CRC-verified frames only (digital_crc32_async_bb in check\nmode
      already dropped anything corrupted upstream of this block).\nEnforces unique
      addressing, forwards accepted frames to the app, and\nauto-generates + transmits
      an ACK for anything that isn't itself an\nACK.", ['my_id'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1520, 696.0]
    rotation: 180
    state: enabled
- name: epy_block_frame_trim
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nHDR_LEN\
      \ = 7\nMAX_FRAG_PAYLOAD = 180  # must match link_layer.py's MAX_FRAG_PAYLOAD\n\
      \n\nclass frame_trim(gr.basic_block):\n    \"\"\"Slices the continuous demodulated\
      \ byte stream (arriving as PDUs from\n    pdu_tagged_stream_to_pdu, one access-code-synced\
      \ burst at a time) into\n    exact-length frames using the 7-byte header's `len`\
      \ field. Bogus header\n    bytes (from noise that happened to correlate against\
      \ the access code)\n    are resynced past one byte at a time rather than stalling\
      \ the buffer.\"\"\"\n\n    def __init__(self):\n        gr.basic_block.__init__(self,\
      \ name=\"Frame Trim\", in_sig=None, out_sig=None)\n        self.buffer = []\n\
      \        self.message_port_register_in(pmt.mp(\"in\"))\n        self.message_port_register_out(pmt.mp(\"\
      out\"))\n        self.set_msg_handler(pmt.mp(\"in\"), self.handle_msg)\n\n \
      \   def handle_msg(self, msg):\n        meta = pmt.car(msg)\n        self.buffer.extend(list(pmt.u8vector_elements(pmt.cdr(msg))))\n\
      \n        while len(self.buffer) >= HDR_LEN:\n            msg_type = self.buffer[5]\n\
      \            payload_len = self.buffer[6]\n\n            # Sanity-check the\
      \ header before committing to a frame length;\n            # if it looks bogus,\
      \ drop one byte and keep scanning.\n            if msg_type > 3 or payload_len\
      \ > MAX_FRAG_PAYLOAD:\n                self.buffer.pop(0)\n                continue\n\
      \n            exact_len = HDR_LEN + payload_len + 4  # +4 for CRC32 trailer\n\
      \n            if len(self.buffer) < exact_len:\n                break  # wait\
      \ for more bytes\n\n            frame = self.buffer[:exact_len]\n          \
      \  pdu_out = pmt.init_u8vector(len(frame), frame)\n            self.message_port_pub(pmt.mp(\"\
      out\"), pmt.cons(meta, pdu_out))\n            self.buffer = self.buffer[exact_len:]\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Frame Trim', 'frame_trim', [], [('in', 'message', 1)], [('out', 'message',
      1)], "Slices the continuous demodulated byte stream (arriving as PDUs from\npdu_tagged_stream_to_pdu,
      one access-code-synced burst at a time) into\nexact-length frames using the
      7-byte header's `len` field. Bogus header\nbytes (from noise that happened to
      correlate against the access code)\nare resynced past one byte at a time rather
      than stalling the buffer.", [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 616.0]
    rotation: 0
    state: enabled
- name: epy_block_preamble_pad
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\n\nclass\
      \ add_preamble_pad(gr.basic_block):\n    \"\"\"Unchanged from the earlier working\
      \ prototype: pads short frames to\n    16 bytes minimum, then prepends a 128-byte\
      \ 0x55 dummy preamble (for\n    AGC/loop settling on a bursty link) and the\
      \ 4-byte access code.\"\"\"\n\n    def __init__(self):\n        gr.basic_block.__init__(self,\
      \ name=\"Add Preamble & Pad\", in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.mp(\"\
      in\"))\n        self.message_port_register_out(pmt.mp(\"out\"))\n        self.set_msg_handler(pmt.mp(\"\
      in\"), self.handle_msg)\n\n    def handle_msg(self, msg):\n        meta = pmt.car(msg)\n\
      \        vec = list(pmt.u8vector_elements(pmt.cdr(msg)))\n\n        min_bytes\
      \ = 16\n        if len(vec) < min_bytes:\n            vec += [0x00] * (min_bytes\
      \ - len(vec))\n\n        dummy = [0x55] * 128\n        preamble = [0xAC, 0x62,\
      \ 0x0D, 0xCD]\n\n        full_packet = dummy + preamble + vec\n        pdu_out\
      \ = pmt.init_u8vector(len(full_packet), full_packet)\n        self.message_port_pub(pmt.mp(\"\
      out\"), pmt.cons(meta, pdu_out))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Add Preamble & Pad'', ''add_preamble_pad'', [], [(''in'', ''message'',
      1)], [(''out'', ''message'', 1)], ''Unchanged from the earlier working prototype:
      pads short frames to\n16 bytes minimum, then prepends a 128-byte 0x55 dummy
      preamble (for\nAGC/loop settling on a bursty link) and the 4-byte access code.'',
      [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [928, 744.0]
    rotation: 180
    state: enabled
