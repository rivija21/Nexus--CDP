- name: tx_framer
  id: epy_block
  parameters:
    _source_code: "\"\"\"BPSK transmit framer (r6.1, embedded block).\n\nMessage port\
      \ 'frames' in: link frames (PDUs) from the node block. Port 'ctl'\nin: {'enable':\
      \ bool}. Stream out: BPSK symbols, one per symbol period, to the\ninterpolating\
      \ RRC filter. Port 'status' out, every 50 ms: the transmit\nbacklog, so the\
      \ node's airtime model tracks the real queue.\n\nThe radio pulls symbols at\
      \ exactly its own rate, so this block's queue is\nthe whole transmit backlog.\
      \ While enabled, gaps between frames are filled\nwith a PRBS-15 pattern (no\
      \ access code can appear in it) so the carrier is\ncontinuous without the link\
      \ layer making ~200 IDLE frames a second; while\ndisabled (the MAC listening\
      \ or checking its channel) it sends zeros, which\nkeeps the DAC fed - no 'U'\
      \ - and the channel silent. Switching off is\nimmediate: the frame on air and\
      \ any still queued are discarded (the link\nlayer's ARQ resends what mattered).\
      \ The framing and modulation\nare bpsk_phy.TxFramer, identical on air to r6.0's\
      \ tagged_stream_mux +\ngeneric_mod(differential BPSK).\n\"\"\"\n\nimport os\n\
      import sys\nimport time\nimport traceback\n\nimport numpy as np\nimport pmt\n\
      from gnuradio import gr\n\n\ndef _load(name):\n    \"\"\"Load a sibling module\
      \ by path (see the deframer block).\"\"\"\n    import importlib.util\n    if\
      \ name in sys.modules:\n        return sys.modules[name]\n    roots = []\n \
      \   try:\n        roots.append(os.path.dirname(os.path.abspath(__file__)))\n\
      \    except NameError:\n        pass\n    roots.append(os.getcwd())\n    roots.extend([p\
      \ for p in sys.path if p])\n    for root in roots:\n        path = os.path.join(root,\
      \ name + '.py')\n        if os.path.isfile(path):\n            spec = importlib.util.spec_from_file_location(name,\
      \ path)\n            mod = importlib.util.module_from_spec(spec)\n         \
      \   sys.modules[name] = mod\n            try:\n                spec.loader.exec_module(mod)\n\
      \            except Exception:\n                sys.modules.pop(name, None)\n\
      \                raise\n            return mod\n    return None\n\n\ntry:\n\
      \    _phy = _load('bpsk_phy')\n    _err = '' if _phy is not None else 'bpsk_phy.py\
      \ not found'\nexcept Exception as _e:          # noqa: BLE001 - reported at\
      \ run time\n    _phy, _err = None, repr(_e)\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"BPSK TX framer: link frames in, continuous symbols out.\"\"\"\n\n\
      \    def __init__(self, preamble_size=64, postamble_size=64,\n             \
      \    sym_rate=250000.0, max_backlog=0.5, batch=2560):\n        gr.sync_block.__init__(self,\
      \ name='BPSK TX Framer', in_sig=None,\n                               out_sig=[np.complex64])\n\
      \        self.set_output_multiple(max(64, int(batch)))\n        self._in = pmt.intern('frames')\n\
      \        self._ctl = pmt.intern('ctl')\n        self._out = pmt.intern('status')\n\
      \        self.message_port_register_in(self._in)\n        self.message_port_register_in(self._ctl)\n\
      \        self.message_port_register_out(self._out)\n        # GNU Radio finds\
      \ a Python handler again BY NAME: real methods only.\n        self.set_msg_handler(self._in,\
      \ self._on_frame)\n        self.set_msg_handler(self._ctl, self._on_ctl)\n \
      \       self._core = (_phy.TxFramer(preamble_size, postamble_size, sym_rate,\n\
      \                                    max_backlog) if _phy is not None else None)\n\
      \        self._enabled = False\n        self._flushed = 0\n        self._next\
      \ = 0.0\n        self._faults = 0\n        self._sent_syms = 0\n\n    def _on_frame(self,\
      \ msg):\n        try:\n            if self._core is None or not pmt.is_pair(msg):\n\
      \                return\n            vec = pmt.cdr(msg)\n            if pmt.is_u8vector(vec):\n\
      \                self._core.push(bytes(pmt.u8vector_elements(vec)))\n      \
      \  except Exception:                         # noqa: BLE001\n            self._fault()\n\
      \n    def _on_ctl(self, msg):\n        try:\n            if pmt.is_dict(msg):\n\
      \                val = pmt.dict_ref(msg, pmt.intern('enable'), pmt.PMT_NIL)\n\
      \                if pmt.is_bool(val):\n                    on = pmt.to_bool(val)\n\
      \                    if not on and self._core is not None:\n               \
      \         c = self._core\n                        self._flushed += len(c.queue)\
      \ + (c.cur is not None)\n                        c.queue.clear()\n         \
      \               c.queued_bits = 0\n                        c.cur, c.pos = None,\
      \ 0\n                    self._enabled = on\n        except Exception:     \
      \                    # noqa: BLE001\n            self._fault()\n\n    def _fault(self):\n\
      \        self._faults += 1\n        if self._faults <= 3:\n            traceback.print_exc()\n\
      \n    def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        n = len(out)\n        core = self._core\n        if core is None or\
      \ not self._enabled:\n            out[:] = 0\n        else:\n            try:\n\
      \                out[:] = core.next_symbols(n)\n            except Exception:\
      \                     # noqa: BLE001\n                self._fault()\n      \
      \          out[:] = 0\n        self._sent_syms += n\n        now = time.time()\n\
      \        if now >= self._next:\n            self._next = now + 0.05\n      \
      \      st = {'t': now, 'enabled': self._enabled,\n                  'symbols':\
      \ self._sent_syms, 'flushed': self._flushed,\n                  'faults': self._faults}\n\
      \            if core is not None:\n                st.update(core.stats)\n \
      \               st['backlog'] = core.backlog()\n            else:\n        \
      \        st['error'] = _err\n            self.message_port_pub(self._out, pmt.to_pmt(st))\n\
      \        return n\n"
    affinity: ''
    alias: ''
    batch: '2560'
    comment: frames + PRBS filler, pulled by the radio
    max_backlog: '0.5'
    maxoutbuf: '7680'
    minoutbuf: '7680'
    postamble_size: postamble_size
    preamble_size: preamble_size
    sym_rate: sym_rate
  states:
    _io_cache: '(''BPSK TX Framer'', ''blk'', [(''preamble_size'', ''64''), (''postamble_size'',
      ''64''), (''sym_rate'', ''250000.0''), (''max_backlog'', ''0.5''), (''batch'',
      ''2560'')], [(''frames'', ''message'', 1), (''ctl'', ''message'', 1)], [(''0'',
      ''complex'', 1), (''status'', ''message'', 1)], ''BPSK TX framer: link frames
      in, continuous symbols out.'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2700, 692]
    rotation: 0
    state: enabled
