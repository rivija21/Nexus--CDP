      ''256''), (''queue_ahead'', ''0.03''), (''sym_rate'', ''250000.0''), (''overhead'',
      ''140''), (''rx_dir'', "''.''"), (''nickname'', "''''"), (''http_port'', ''8088''),
      (''open_ui'', ''True''), (''center_freq'', ''0.0''), (''security'', ''True''),
      (''keys_dir'', "''keys''"), (''window'', ''32''), (''channel'', ''-1''), (''ch_spacing'',
      ''600000.0''), (''ch_first'', ''450000.0''), (''radio_rate'', ''6000000.0''),
      (''rx_gain'', ''30''), (''tx_atten'', ''50''), (''agc'', ''True''), (''telemetry'',
      ''True''), (''plan_file'', "''''"), (''count_ou'', ''True'')], [(''chat_in'',
      ''message'', 1), (''iq2'', ''message'', 1), (''meas2'', ''message'', 1), (''rx2'',
      ''message'', 1), (''iq1'', ''message'', 1), (''meas1'', ''message'', 1), (''rx1'',
      ''message'', 1), (''iq0'', ''message'', 1), (''meas0'', ''message'', 1), (''rx0'',
      ''message'', 1), (''txstat'', ''message'', 1), (''adc'', ''message'', 1), (''tick'',
      ''message'', 1), (''rx_frame'', ''message'', 1), (''iq3'', ''message'', 1),
      (''meas3'', ''message'', 1), (''rx3'', ''message'', 1)], [(''afc3'', ''message'',
      1), (''afc2'', ''message'', 1), (''afc1'', ''message'', 1), (''afc0'', ''message'',
      1), (''log'', ''message'', 1), (''tx_attr'', ''message'', 1), (''rx_attr'',
      ''message'', 1), (''tx_ctl'', ''message'', 1), (''tx_en'', ''message'', 1),
      (''tx_frame'', ''message'', 1)], ''BPSK network node: MAC, ARQ link layer, encryption,
      chat UI.'', [''http_port'', ''open_ui'', ''radio_rate''])'
