- name: deframer_ch0
  id: epy_block
  parameters:
    _source_code: "\"\"\"BPSK deframer for one receive channel (r6.1, embedded block).\n\
      \nInput: hard-decision bits (0/1, one per byte) from the differential decoder,\n\
      grouped by a Stream to Vector block into vectors of `batch` bits.\nOutput, message\
      \ port 'pdus': one PDU per link frame, metadata {'ch': k}; and\nonce a second\
      \ a PDU with an empty payload and metadata {'ch': k, 'stats':\n{...}}, which\
      \ the node block uses as this channel's liveness check.\n\nThe search is bpsk_phy.Deframer\
      \ (next to the flowgraph). It replaces\ncorrelate_access_code_bb_ts -> repack_bits_bb\
      \ -> tagged_stream_to_pdu, which\non GNU Radio 3.10.12 could wait for 65535\
      \ bytes after one corrupted header\nand so stall the whole receiver ('repack_bits_bb\
      \ is requesting more input\ndata than we can provide'). This block never waits\
      \ for data it does not\nhave: it takes whatever whole vectors are there (Python\
      \ is entered at most\n~60 times a second per channel instead of once per few\
      \ symbols, and the\nscheduler never calls into Python just to ask - a basic_block's\
      \ forecast()\nwould be a Python call on every scheduler pass), drops an implausible\n\
      length at once, and keeps looking for access codes inside a frame it is\nstill\
      \ collecting, so one bad header costs at most that one frame.\n\"\"\"\n\nimport\
      \ os\nimport sys\nimport time\nimport traceback\n\nimport numpy as np\nimport\
      \ pmt\nfrom gnuradio import gr\n\n\ndef _load(name):\n    \"\"\"Load a sibling\
      \ module by path (GRC validates with exec() and no\n    __file__, from whatever\
      \ directory it was started in).\"\"\"\n    import importlib.util\n    if name\
      \ in sys.modules:\n        return sys.modules[name]\n    roots = []\n    try:\n\
      \        roots.append(os.path.dirname(os.path.abspath(__file__)))\n    except\
      \ NameError:\n        pass\n    roots.append(os.getcwd())\n    roots.extend([p\
      \ for p in sys.path if p])\n    for root in roots:\n        path = os.path.join(root,\
      \ name + '.py')\n        if os.path.isfile(path):\n            spec = importlib.util.spec_from_file_location(name,\
      \ path)\n            mod = importlib.util.module_from_spec(spec)\n         \
      \   sys.modules[name] = mod\n            try:\n                spec.loader.exec_module(mod)\n\
      \            except Exception:\n                sys.modules.pop(name, None)\n\
      \                raise\n            return mod\n    return None\n\n\ntry:\n\
      \    _phy = _load('bpsk_phy')\n    _err = '' if _phy is not None else 'bpsk_phy.py\
      \ not found'\nexcept Exception as _e:          # noqa: BLE001 - reported at\
      \ run time\n    _phy, _err = None, repr(_e)\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"BPSK deframer: bits in, link frames out as PDUs.\"\"\"\n\n    def\
      \ __init__(self, channel=0, max_len=600, batch=8192):\n        gr.sync_block.__init__(self,\
      \ name='BPSK Deframer',\n                               in_sig=[(np.uint8, int(batch))],\
      \ out_sig=None)\n        self.channel = int(channel)\n        self.batch = int(batch)\n\
      \        self._port = pmt.intern('pdus')\n        self.message_port_register_out(self._port)\n\
      \        self._core = (_phy.Deframer(max_len=int(max_len))\n               \
      \       if _phy is not None else None)\n        self._ch = pmt.from_long(self.channel)\n\
      \        self._k_ch = pmt.intern('ch')\n        self._k_stats = pmt.intern('stats')\n\
      \        self._empty = pmt.init_u8vector(0, [])\n        self._next = 0.0\n\
      \        self._faults = 0\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        n = len(x)\n        frames = ()\n     \
      \   if n and self._core is not None:\n            try:\n                frames\
      \ = self._core.feed(x.reshape(-1))\n            except Exception:          \
      \           # noqa: BLE001\n                self._faults += 1\n            \
      \    if self._faults <= 3:\n                    traceback.print_exc()\n    \
      \    for f in frames:\n            meta = pmt.dict_add(pmt.make_dict(), self._k_ch,\
      \ self._ch)\n            self.message_port_pub(self._port, pmt.cons(\n     \
      \           meta, pmt.init_u8vector(len(f), list(f))))\n        now = time.time()\n\
      \        if now >= self._next:\n            self._next = now + 1.0\n       \
      \     st = dict(self._core.stats) if self._core is not None else {}\n      \
      \      st['faults'] = self._faults\n            if self._core is None:\n   \
      \             st['error'] = _err\n            meta = pmt.dict_add(pmt.make_dict(),\
      \ self._k_ch, self._ch)\n            meta = pmt.dict_add(meta, self._k_stats,\
      \ pmt.to_pmt(st))\n            self.message_port_pub(self._port, pmt.cons(meta,\
      \ self._empty))\n        return n\n"
    affinity: ''
    alias: ''
    batch: '8192'
    channel: '0'
    comment: ''
    max_len: '600'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''BPSK Deframer'', ''blk'', [(''channel'', ''0''), (''max_len'',
      ''600''), (''batch'', ''8192'')], [(''0'', ''byte'', 8192)], [(''pdus'', ''message'',
      1)], ''BPSK deframer: bits in, link frames out as PDUs.'', [''batch'', ''channel''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2060, 640]
    rotation: 0
    state: enabled
