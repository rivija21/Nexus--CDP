- name: arq_window
  id: parameter
  parameters:
    alias: ''
    comment: Selective Repeat window, 1..64; 1 = stop-and-wait
    hide: none
    label: ARQ window (frames)
    short_id: ''
    type: intx
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 16]
    rotation: 0
    state: enabled
- name: bits_to_vec_ch0
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: 33 ms of bits per Python call; 4 s buffered, so a slow deframer never
      stalls the receiver
    maxoutbuf: '0'
    minoutbuf: '128'
    num_items: '8192'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1860, 640]
    rotation: 0
    state: enabled
