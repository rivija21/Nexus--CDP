    minoutbuf: '0'
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [660, 1300]
    rotation: 0
    state: enabled
- name: agc_ch3
  id: analog_agc3_xx
  parameters:
    affinity: ''
    alias: ''
    attack_rate: '1.0'
    comment: ''
    decay_rate: 1e-4
    gain: '1.0'
