options:
  parameters:
    author: Rivija Pesara (framing from Barry Duggan BPSK example)
    catch_exceptions: 'False'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'BPSK network node: 4-channel FDMA mesh (6 MS/s, one-sided plan),
      self-assigned channels and addresses, closed-loop gain staging, Selective Repeat
      ARQ per peer, end-to-end encryption per pair, browser chat (r6.1-mesh)'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: bpsk_duplex_pluto
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: BPSK Mesh Node (Pluto, 4-channel FDMA, r6.1)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: ack_timeout
  id: variable
  parameters:
    comment: seconds before retransmit
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 260]
    rotation: 0
    state: enabled
- name: ch_rate
  id: variable
  parameters:
    comment: each channel after its channel filter
    value: sps*sym_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 260]
    rotation: 0
    state: enabled
- name: ch_taps
  id: variable
  parameters:
    comment: 'pass +-175 kHz flat, stop from 425 kHz (65 dB): adjacent channels and
      the own transmitter on its channel'
    value: firdes.low_pass_2(1.0, radio_rate, 0.5*ch_spacing, 0.4167*ch_spacing, 65)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 260]
    rotation: 0
    state: enabled
- name: constel
  id: variable_constellation
  parameters:
    comment: ''
    const_points: '[-1-1j, -1+1j, 1+1j, 1-1j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    npwr: '1.0'
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    type: bpsk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [712, 452]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: channel filter decimation
    value: tx_interp//sps
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 260]
    rotation: 0
    state: enabled
- name: frag_size
  id: variable
  parameters:
    comment: bytes of file data per frame
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 260]
    rotation: 0
    state: enabled
- name: max_retries
  id: variable
  parameters:
    comment: ''
    value: '5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 260]
    rotation: 0
    state: enabled
- name: queue_ahead
  id: variable
  parameters:
    comment: seconds of airtime queued ahead of the radio
    value: '0.03'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 260]
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: matched filter
    value: firdes.root_raised_cosine(1.0, ch_rate, sym_rate, 0.35, 11*sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1768, 260]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: samples per symbol in each receive chain
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 260]
    rotation: 0
    state: enabled
- name: sym_rate
  id: variable
  parameters:
    comment: 'symbols per second on every channel: 250k at 6 MS/s'
    value: radio_rate/tx_interp
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 260]
    rotation: 0
    state: enabled
- name: tx_interp
  id: variable
  parameters:
    comment: radio samples per symbol (6 MS/s / 250 ksym/s)
    value: '24'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [712, 260]
    rotation: 0
    state: enabled
- name: tx_scale
  id: variable
  parameters:
    comment: 'digital back-off: symbol peaks near -6 dBFS'
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 356]
    rotation: 0
    state: enabled
- name: tx_taps
  id: variable
  parameters:
    comment: RRC interpolation straight to the radio rate, 16-symbol span
    value: '[tx_scale*t for t in firdes.root_raised_cosine(tx_interp, tx_interp, 1.0,
      0.35, 16*tx_interp+1)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 356]
    rotation: 0
    state: enabled
- name: adc_keep
  id: blocks_keep_m_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: raw ADC samples, 20 snapshots a second
    m: '8192'
    maxoutbuf: '0'
    minoutbuf: '0'
    n: '300000'
    offset: '0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [300, 1840]
    rotation: 0
    state: enabled
- name: adc_pdu
  id: pdu_tagged_stream_to_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: packet_len
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 1840]
    rotation: 0
    state: enabled
- name: adc_pkt
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '32768'
    packet_len: '8192'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 1840]
    rotation: 0
    state: enabled
- name: afc_ch0
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: carrier offset correction (node AFC)
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: '0'
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 640]
    rotation: 0
    state: enabled
- name: afc_ch1
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: '0'
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 940]
    rotation: 0
    state: enabled
- name: afc_ch2
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: '0'
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 1240]
    rotation: 0
    state: enabled
- name: afc_ch3
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: '0'
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 1540]
    rotation: 0
    state: enabled
- name: agc
  id: parameter
  parameters:
    alias: ''
    comment: 1 = closed-loop RX gain / TX attenuation; 0 = fixed (/gain to move)
    hide: none
    label: Gain control (1/0)
    short_id: ''
    type: intx
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 128]
    rotation: 0
    state: enabled
- name: agc_ch0
  id: analog_agc3_xx
  parameters:
    affinity: ''
    alias: ''
    attack_rate: '1.0'
    comment: 'normalises the channel (symbol sync and Costas loop gains assume unit
      amplitude). Attack 1.0: a sample can never leave above 1.0, so a transmitter
      switching on cannot spike the symbol sync (agc2 did - it wedged)'
    decay_rate: 1e-4
    gain: '1.0'
    iir_update_decim: '1'
    max_gain: 1e5
    maxoutbuf: '0'
    minoutbuf: '0'
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [660, 700]
    rotation: 0
    state: enabled
- name: agc_ch1
  id: analog_agc3_xx
  parameters:
    affinity: ''
    alias: ''
    attack_rate: '1.0'
    comment: ''
    decay_rate: 1e-4
    gain: '1.0'
    iir_update_decim: '1'
    max_gain: 1e5
    maxoutbuf: '0'
    minoutbuf: '0'
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [660, 1000]
    rotation: 0
    state: enabled
- name: agc_ch2
  id: analog_agc3_xx
  parameters:
