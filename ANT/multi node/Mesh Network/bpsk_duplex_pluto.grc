- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: drives ARQ timers, beacons and the node's housekeeping
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.intern("tick")
    period: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2420, 492]
    rotation: 0
    state: enabled
- name: center_freq
  id: parameter
  parameters:
    alias: ''
    comment: 'the same on every node: every channel sits above it'
    hide: none
    label: Centre frequency (Hz)
    short_id: ''
    type: eng_float
    value: 910.2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 16]
    rotation: 0
    state: enabled
- name: ch_first
  id: parameter
  parameters:
    alias: ''
    comment: 'r6.1 one-sided plan: channel k at ch_first + k*ch_spacing'
    hide: none
    label: Channel 0 offset (Hz)
    short_id: ''
    type: eng_float
    value: 450e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 16]
    rotation: 0
    state: enabled
- name: ch_spacing
  id: parameter
  parameters:
    alias: ''
    comment: must divide radio_rate
    hide: none
    label: Channel spacing (Hz)
    short_id: ''
    type: eng_float
    value: 600e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 16]
    rotation: 0
    state: enabled
- name: chan_filter_ch0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: ch_first+0*ch_spacing
    comment: ''
    decim: decim
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: radio_rate
    taps: ch_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [300, 640]
    rotation: 0
    state: enabled
